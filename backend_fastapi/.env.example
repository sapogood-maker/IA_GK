# ==============================================================
# Goalkeeper AI - Backend - variaveis de ambiente
#
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA commite o arquivo ".env" (ele contem segredos reais).
# ==============================================================

# --- Banco de dados ---
# String de conexao PostgreSQL usada pelo SQLAlchemy AsyncEngine.
# Precisa do driver assincrono "+asyncpg" (NAO usar "postgresql://" puro,
# a aplicacao normaliza automaticamente, mas o valor correto evita confusao).
# Em Docker/Coolify, o host geralmente e o nome do servico (ex.: "postgres"),
# nao "localhost".
DATABASE_URL=postgresql+asyncpg://goalkeeper_user:goalkeeper_pass@localhost:5433/goalkeeper_ai

# --- Autenticacao JWT ---
# Chave secreta usada para assinar os tokens JWT. Gere uma chave forte e
# unica por ambiente (nunca reutilize o valor de exemplo abaixo).
JWT_SECRET_KEY=change-this-to-a-random-secret-with-32-or-more-characters
# Algoritmo de assinatura do JWT.
JWT_ALGORITHM=HS256
# Tempo de vida do access_token, em minutos.
JWT_EXPIRATION_MINUTES=30
# Tempo de vida do refresh_token, em dias.
REFRESH_TOKEN_EXPIRATION_DAYS=7

# --- Ambiente ---
# "development" habilita o echo de SQL nos logs; use "production" fora do dev.
ENV=development

# --- Cloudflare R2 (armazenamento de videos) ---
# ID da conta Cloudflare, disponivel no painel do R2.
R2_ACCOUNT_ID=your-cloudflare-account-id
# Credenciais de acesso S3-compativeis do bucket R2 (criadas no painel do R2,
# em "Manage R2 API Tokens").
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Nome do bucket R2 usado para armazenar os videos enviados.
R2_BUCKET_NAME=your-r2-bucket-name
# URL publica do bucket (dominio customizado ou o dominio padrao do R2:
# https://<account-id>.r2.cloudflarestorage.com).
R2_PUBLIC_URL=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# --- Upload de videos ---
# Tamanho maximo de arquivo de video aceito, em bytes (padrao: 500 MB).
MAX_VIDEO_SIZE_BYTES=524288000
# Extensoes de video aceitas, separadas por virgula, sem espacos e sem
# colchetes/JSON (ex.: mp4,mov,avi,mkv).
ALLOWED_VIDEO_EXTENSIONS=mp4,mov,avi,mkv

# --- AI Worker (preparacao de infraestrutura - Sprint 7) ---
# Segredo compartilhado que o futuro AI Worker envia no header
# X-Worker-Api-Key. Mecanismo completamente separado do JWT de usuario
# humano (ver app/core/worker_auth.py). Gere um valor forte e unico -
# NUNCA reutilize o valor de exemplo abaixo.
WORKER_API_KEY=change-this-to-a-random-worker-secret
# Tempo de validade (segundos) das URLs assinadas do R2 que o Worker usa
# para baixar o video original e para subir artefatos gerados.
WORKER_DOWNLOAD_URL_EXPIRATION_SECONDS=3600
WORKER_UPLOAD_URL_EXPIRATION_SECONDS=3600

# --- Fila de processamento (Redis Streams) ---
# OBRIGATORIA - sem valor padrao (ver app/core/config.py). Usada para
# publicar cada ProcessingJob criado no upload (app/core/queue.py, stream
# "processing_jobs"); o AI Worker e quem consome
# (goalkeeper_ai_worker/worker/infrastructure/redis/consumer.py).
#
# Em Docker/Coolify, o host e o nome do RESOURCE Redis dedicado ao
# Goalkeeper AI (NUNCA "localhost", e NUNCA reaproveitar um Redis de outro
# proposito, como o Redis interno do proprio Coolify) - normalmente algo
# como "redis://default:<senha>@<nome-do-resource>:6379/0", valor que o
# proprio Coolify mostra na tela de configuracao do resource Redis.
#
# Diagnostico: GET /api/v1/queue/health (JWT de system_admin) reporta
# "connected": true/false contra este Redis, sem precisar do Worker rodando.
REDIS_URL=redis://localhost:6379/0
