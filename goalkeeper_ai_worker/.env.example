# Ambiente de execucao do Worker (development | production)
WORKER_ENV=development

# Identificador unico desta instancia de Worker (Worker Instance - ver
# AI_WORKER_CONSTITUTION.md, Glossario). Obrigatorio, sem valor padrao.
WORKER_INSTANCE_ID=worker-local-01

# Nivel de log (DEBUG | INFO | WARNING | ERROR)
WORKER_LOG_LEVEL=INFO

# --- Redis (fila de processamento - ver AI_WORKER_CONSTITUTION.md Secao 2/13) ---
# Deve apontar para o MESMO Redis que o backend usa para publicar Jobs.
WORKER_REDIS_URL=redis://localhost:6379/0

# Nome do consumer group (Sprint W2, ADR arquitetural: fixo por convencao -
# todas as instancias de Worker DEVEM usar o mesmo grupo para balancear
# carga corretamente).
WORKER_CONSUMER_GROUP=goalkeeper_ai_worker

# --- Worker API do backend (REST + API Key - ver AI_WORKER_CONSTITUTION.md Secao 9) ---
WORKER_BACKEND_API_URL=http://localhost:8001

# Mesmo VALOR configurado como WORKER_API_KEY no .env do backend - cada lado
# mantem seu proprio arquivo de configuracao (Boundary Enforcement); os dois
# precisam apenas concordar no segredo, que e a natureza de autenticacao por
# API Key compartilhada.
WORKER_API_KEY=dev-worker-api-key-change-in-production

# --- Lock distribuido por video (ADR-001/003) ---
WORKER_LOCK_TTL_SECONDS=300

# --- Identificacao de protocolo (Sprint W2) ---
# Versao do contrato REST falado com o backend - enviada em toda chamada via
# header X-Worker-Version. Distinta da versao de software do Worker
# (worker.__version__).
WORKER_PROTOCOL_VERSION=1.0

# --- Motor de inferencia ativo (Sprint W4/W6) ---
# Resolvido pelo Registry (worker/inference/registry.py). "basic_vision" e
# o motor padrao desde a W6 (processa frames de verdade, sem deteccao);
# "fake" continua registrado, usado nos testes. Futuramente "yolo"/
# "multimodel" sem alterar o Pipeline.
WORKER_INFERENCE_ENGINE=basic_vision

# --- Pre-processamento de frame do BasicVisionEngine (Sprint W6) ---
# Todas opcionais - sem elas, processa cada frame na resolucao original.
WORKER_FRAME_SKIP=0
WORKER_ENABLE_RESIZE=false
WORKER_TARGET_WIDTH=0
WORKER_TARGET_HEIGHT=0
WORKER_ENABLE_ROI=false
WORKER_ROI_X=0
WORKER_ROI_Y=0
WORKER_ROI_WIDTH=0
WORKER_ROI_HEIGHT=0

# --- Habilitacao de Processors da pipeline interna do BasicVisionEngine (Sprint W7) ---
# ResizeProcessor/ROIProcessor sao controlados por WORKER_ENABLE_RESIZE/WORKER_ENABLE_ROI
# acima. Estes dois cobrem Color e Statistics, que nao tinham flag propria ate a W7.
WORKER_ENABLE_COLOR_PROCESSOR=true
WORKER_ENABLE_STATISTICS_PROCESSOR=true

# --- API de Deteccao (Sprint W8) ---
# WORKER_DETECTOR vazio (padrao) = YOLOProcessor desabilitado, nenhum modelo
# e carregado. "yolo" habilita o YOLOProcessor, resolvendo o Detector real
# (YOLODetector) via worker/inference/detectors/registry.py.
WORKER_DETECTOR=
WORKER_MODEL_PATH=weights/yolo11n.pt
WORKER_CONFIDENCE_THRESHOLD=0.25
WORKER_IOU_THRESHOLD=0.45

# --- API de Tracking (Sprint W9) ---
# WORKER_TRACKER e WORKER_TRACKING_ENABLED sao interruptores independentes
# de proposito - permite configurar o Tracker sem ainda habilita-lo.
# Requer WORKER_DETECTOR configurado (o Tracker consome DetectionResult).
WORKER_TRACKER=
WORKER_TRACKING_ENABLED=false
WORKER_TRACK_MIN_CONFIDENCE=0.25
WORKER_TRACK_MAX_AGE=30
WORKER_TRACK_MIN_HITS=1

# --- API de Eventos de Cena (Sprint W10) ---
# WORKER_SCENE_ANALYZER e WORKER_SCENE_ANALYSIS_ENABLED sao interruptores
# independentes de proposito - mesmo padrao de WORKER_TRACKER/
# WORKER_TRACKING_ENABLED. Requer WORKER_TRACKER habilitado (o SceneAnalyzer
# consome TrackingResult).
WORKER_SCENE_ANALYZER=
WORKER_SCENE_ANALYSIS_ENABLED=false
WORKER_SCENE_MOTION_THRESHOLD_PX=5.0
WORKER_SCENE_OCCLUSION_IOU_THRESHOLD=0.3

# --- World Model (Sprint W11) ---
# WORKER_WORLD_MODEL e WORKER_WORLD_MODEL_ENABLED sao interruptores
# independentes de proposito - mesmo padrao de WORKER_TRACKER/
# WORKER_TRACKING_ENABLED. Requer WORKER_SCENE_ANALYZER configurado (o
# World Model consome SceneAnalysisResult). Ultima camada generica da
# arquitetura - a partir da W12, analisadores especificos de futebol
# consomem WorldState.
WORKER_WORLD_MODEL=
WORKER_WORLD_MODEL_ENABLED=false
WORKER_WORLD_HISTORY_SIZE=30
WORKER_WORLD_MAX_TRAJECTORY=30
WORKER_WORLD_MAX_OBJECTS=200

# --- Football Domain Model (Sprint W12) ---
# Um unico interruptor (nao ha "qual implementacao" - FootballWorldBuilder
# e a unica implementacao do dominio, sem Registry/factory nesta camada).
# Requer WORKER_WORLD_MODEL_ENABLED (o Football Domain Model consome WorldState).
WORKER_FOOTBALL_DOMAIN_ENABLED=false

# --- Analyzer API (Sprint W13) ---
# Lista de Analyzers ativos, separados por virgula (ex.: "goalkeeper_presence").
# Vazio (padrao) = AnalyzerProcessor desabilitado. Diferente de
# Detector/Tracker/SceneAnalyzer/WorldModel (um unico ativo por vez), varios
# Analyzers podem rodar simultaneamente - cada um responde uma pergunta
# independente sobre o mesmo FootballWorld. Requer WORKER_FOOTBALL_DOMAIN_ENABLED
# (todo Analyzer consome exclusivamente FootballWorld).
WORKER_ANALYZERS=
