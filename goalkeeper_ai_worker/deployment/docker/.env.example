# Goalkeeper AI Worker - variaveis de ambiente do docker-compose (Deployment v1.0).
# Copie para ".env" (MESMO diretorio deste arquivo) antes de rodar
# `docker compose up` - NUNCA versionar o .env real (contem segredos).
#
# Esta e a lista ENXUTA para subir o Worker em Docker. Para a lista
# COMPLETA de variaveis (todos os limiares/parametros dos 15 Analyzers,
# W13-W27, todos opcionais) ver ../../.env.example (raiz do repositorio
# do Worker) - qualquer variavel de la tambem pode ser adicionada aqui,
# sem nenhuma mudanca no Dockerfile/docker-compose.yml.

# --- Obrigatorias (sem valor padrao - o Worker recusa iniciar sem elas) ---
WORKER_INSTANCE_ID=worker-docker-01
# Se o backend roda em Coolify, use o MESMO dominio publico usado pelo
# navegador/Flutter (Traefik roteia por Host header, que um cliente HTTP
# baseado em dominio ja envia certo) - nao precisa de IP direto nem Port
# Mapping, contanto que o dominio resolva e a rede alcance a porta 80/443:
#   WORKER_BACKEND_API_URL=http://<dominio-do-backend>.sslip.io
WORKER_BACKEND_API_URL=http://host.docker.internal:8001
WORKER_API_KEY=dev-worker-api-key-change-in-production

# --- Redis - DEVE ser o mesmo Redis que o backend usa para publicar Jobs ---
# host.docker.internal funciona nativamente no Docker Desktop (Windows/Mac)
# e aponta para o PROPRIO host Docker - so correto se Redis/backend rodam
# no mesmo host do Worker. No Ubuntu + Docker Engine, o docker-compose.yml
# ja inclui o `extra_hosts` necessario para o mesmo nome resolver igual.
#
# Se Redis/backend rodam em Coolify, numa VM SEPARADA na mesma rede local
# (nao no mesmo host do Worker), host.docker.internal NAO se aplica - use
# o IP de LAN da VM direto (container Docker no Windows alcanca qualquer
# IP de LAN normalmente, sem extra_hosts extra):
#   WORKER_REDIS_URL=redis://default:<senha>@<ip-lan-da-vm>:<porta>/0
WORKER_REDIS_URL=redis://host.docker.internal:6379/0

# --- Ambiente/observabilidade ---
WORKER_ENV=production
WORKER_LOG_LEVEL=INFO
# Caminho DENTRO do container - corresponde ao volume worker_logs
# (docker-compose.yml monta em /app/logs). Vazio = so stdout (docker logs).
WORKER_LOG_DIR=/app/logs
# Quanto tempo (segundos) o entrypoint aguarda o Redis antes de desistir.
WORKER_STARTUP_WAIT_TIMEOUT_SECONDS=60

# --- Motor de inferencia (Sprint W6/W8/W9/W10/W11/W12) ---
WORKER_INFERENCE_ENGINE=basic_vision
WORKER_DETECTOR=yolo
# Caminho DENTRO do container - corresponde ao volume worker_weights
# (docker-compose.yml monta em /app/weights). Baixado automaticamente
# pela Ultralytics no primeiro uso se o arquivo nao existir no volume.
WORKER_MODEL_PATH=weights/yolo11n.pt
WORKER_CONFIDENCE_THRESHOLD=0.25
WORKER_IOU_THRESHOLD=0.45
WORKER_TRACKER=bytetrack
WORKER_TRACKING_ENABLED=true
WORKER_SCENE_ANALYZER=basic
WORKER_SCENE_ANALYSIS_ENABLED=true
WORKER_WORLD_MODEL=basic
WORKER_WORLD_MODEL_ENABLED=true
WORKER_FOOTBALL_DOMAIN_ENABLED=true

# --- Analyzer API (Sprint W13-W27) - os 15 Analyzers, na ordem em que ---
# --- foram implementados; qualquer subconjunto pode ser usado.        ---
WORKER_ANALYZERS=goalkeeper_presence,goal_geometry,goalkeeper_position,ball_position,goalkeeper_ball_alignment,ball_motion,shot,ball_trajectory,play_situation,goalkeeper_decision,goalkeeper_decision_evaluation,play_outcome,goalkeeper_performance_evaluation,goalkeeper_coaching,goalkeeper_analysis_report
